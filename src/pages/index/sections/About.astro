---
import Card from "../../../components/Card.astro";

const programmers = [
  {
    number: "01",
    title: "Mariane Joy Guban",
    description: "Enjoys creating clear, welcoming interfaces.",
    items: ["HTML & CSS", "UI design", "Responsive layouts"],
  },
  {
    number: "02",
    title: "Miles Martin Pabon",
    description: "Likes turning ideas into practical website features.",
    items: ["JavaScript", "Astro", "Problem solving"],
  },
  {
    number: "03",
    title: "Gian Baldelovar",
    description: "Interested in building responsive web experiences.",
    items: ["Astro", "Frontend development", "CSS animation"],
  },
];
---

<section class="about" id="about">
  <div class="container about-grid">
    <div class="about-label">
      <p class="eyebrow">01 — About</p>
    </div>
    <div class="about-content">
      <h2 class="section-title">A team that values clarity.</h2>
      <div class="about-bottom">
        <div class="story-copy">
          <p class="story-lead">We’re a team of developers: Mariane Joy Guban, Miles Martin Pabon, and Gian Baldelovar. We build practical, user-friendly websites.</p>
          <p>We enjoy turning ideas into clean interfaces, learning how the pieces of the web fit together, and improving a project one detail at a time.</p>
          <p>Our approach balances curiosity with care: understand the problem, keep the experience simple, and write code that is clear to work with.</p>
        </div>
        <div class="about-stat">
          <strong>Web</strong>
          <span>thoughtful ideas<br />made interactive</span>
        </div>
      </div>
    </div>
  </div>
  <div class="container strengths">
    <div class="strengths-heading">
      <p class="eyebrow">Our team strengths</p>
      <p>Different skills, brought together to build one complete experience.</p>
    </div>
    <div class="strengths-grid">
      {programmers.map((programmer) => <Card variant="strength" {...programmer} />)}
    </div>
  </div>
</section>

<style>
  .about { padding: 140px 0; background: var(--paper); border-top: 1px solid var(--line); }
  .about-grid { display: grid; grid-template-columns: 25% 75%; }
  .about-label { padding-top: 8px; }
  .about-content { border-left: 1px solid var(--line); padding-left: 58px; }
  .about-bottom { display: grid; grid-template-columns: 1fr 220px; gap: 64px; align-items: end; margin-top: 52px; }
  .story-copy { max-width: 570px; }
  .story-copy p { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.75; }
  .story-copy p + p { margin-top: 18px; }
  .story-copy .story-lead { margin-bottom: 22px; color: var(--ink); font-family: "Manrope", sans-serif; font-size: 21px; font-weight: 700; line-height: 1.45; }
  .about-stat { display: flex; align-items: flex-end; gap: 14px; padding: 18px 0 4px 20px; border-left: 3px solid var(--accent-brown); }
  .about-stat strong { font-family: "Manrope", sans-serif; font-size: 58px; line-height: .8; letter-spacing: -.06em; }
  .about-stat span { color: var(--muted); font-size: 12px; line-height: 1.5; text-transform: uppercase; }
  .strengths { margin-top: 120px; }
  .strengths-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 36px; margin-bottom: 38px; }
  .strengths-heading .eyebrow { margin: 0; }
  .strengths-heading > p:last-child { max-width: 380px; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .strengths-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  @media (max-width: 760px) {
    .about { padding: 90px 0; } .about-grid { display: block; } .about-label { margin-bottom: 38px; }
    .about-content { border-left: 0; border-top: 1px solid var(--line); padding: 38px 0 0; }
    .about-bottom { grid-template-columns: 1fr; gap: 38px; margin-top: 34px; }
    .strengths { margin-top: 80px; }
    .strengths-heading { display: block; }
    .strengths-heading > p:last-child { margin-top: 16px; }
    .strengths-grid { grid-template-columns: 1fr; }
    .strengths-grid :global(.card--strength) { min-height: 0; border-right: 0; border-bottom: 1px solid var(--line); padding: 24px 0; }
    .strengths-grid :global(.card--strength + .card--strength) { padding-left: 0; }
  }
</style>